<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Headline -->
    <style name="Text.HeadlineXL">
        <item name="android:textSize">@dimen/text_headline_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.HeadlineLg">
        <item name="android:textSize">@dimen/text_headline_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.HeadlineMd">
        <item name="android:textSize">@dimen/text_headline_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.HeadlineSm">
        <item name="android:textSize">@dimen/text_headline_sm</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body -->
    <style name="Text.BodyLg">
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodyMd">
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodySm">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.BodyXs">
        <item name="android:textSize">@dimen/text_body_xs</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Tab -->
    <style name="Text.TabSm">
        <item name="android:textSize">@dimen/text_tab_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Primary Button -->
    <style name="Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:backgroundTint">@color/background_accent1</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>

