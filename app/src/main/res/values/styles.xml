<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base styles for dot-notation inheritance -->
    <style name="Text" />
    <style name="Button" />
    <style name="Card" />
    <style name="Input" />
    <style name="Badge" />

    <!-- Headline -->
    <style name="Text.HeadlineXL">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_headline_xl</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.HeadlineLg">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_headline_lg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.HeadlineMd">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_headline_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.HeadlineSm">
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textSize">@dimen/text_headline_sm</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body -->
    <style name="Text.BodyLg">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">@dimen/text_body_lg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodyMd">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.BodySm">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.BodyXs">
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textSize">@dimen/text_body_xs</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Tab -->
    <style name="Text.TabSm">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">@dimen/text_tab_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Primary Button -->
    <style name="Button.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:backgroundTint">@null</item>

        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Card -->
    <style name="Card.Default">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_lg</item>
    </style>

    <!-- Text Input -->
    <style name="Input.Default">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_text_input</item>

        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_body_sm</item>

        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Status Badge -->
    <style name="Badge.Status">
        <item name="android:background">@drawable/bg_status_badge</item>

        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/background_accent1</item>
        <item name="android:textSize">@dimen/text_body_xs</item>

        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>
    <!-- Round Image Corner -->
    <style name="ShapeAppearance.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Button.Warning">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_warning</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/text_warning</item>
        <item name="android:textSize">@dimen/text_body_md</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>