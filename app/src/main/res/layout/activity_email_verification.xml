<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.EmailVerificationActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xl"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="72dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_status_badge">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_mail_check"
                    android:contentDescription="@string/emailVerificationTitle"
                    app:tint="@color/background_accent1" />

            </FrameLayout>

            <TextView
                android:id="@+id/txtVerificationTitle"
                style="@style/Text.HeadlineMd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/emailCodeTitle" />

            <TextView
                android:id="@+id/txtVerificationMessage"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                tools:text="Send a verification code to your email." />

            <EditText
                android:id="@+id/editVerificationCode"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/hintEmailVerificationCode"
                android:inputType="number"
                android:maxLength="6"
                android:saveEnabled="false"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnVerificationContinue"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btnVerifyEmailCode"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnResendVerification"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_role_default"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/btnSendEmailCode"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_sm"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
