<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_white">
    <include android:id="@+id/header" layout="@layout/component_header"
        android:layout_width="0dp" android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/screen_padding">
            <TextView style="@style/Text.BodySm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="24dp"
                android:text="@string/msgPasswordChangeInstructions" />
            <EditText android:id="@+id/editCurrentPassword" style="@style/Input.Default"
                android:hint="@string/hintCurrentPassword" android:inputType="textPassword" android:saveEnabled="false"
                android:autofillHints="password" />
            <EditText android:id="@+id/editNewPassword" style="@style/Input.Default"
                android:layout_marginTop="@dimen/space_md" android:hint="@string/hintNewPassword"
                android:inputType="textPassword" android:saveEnabled="false" android:autofillHints="newPassword" />
            <EditText android:id="@+id/editConfirmNewPassword" style="@style/Input.Default"
                android:layout_marginTop="@dimen/space_md" android:hint="@string/hintConfirmNewPassword"
                android:inputType="textPassword" android:saveEnabled="false" android:autofillHints="newPassword" />
            <Button android:id="@+id/btnChangePassword" style="@style/Button.Primary"
                android:layout_marginTop="@dimen/space_xl" android:text="@string/btnChangePassword"
                app:backgroundTint="@null" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
