<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.ChooseRoleActivity">

    <!-- Header -->
    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title -->
        <TextView
            android:id="@+id/txtChooseRoleTitle"
            style="@style/Text.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chooseRoleTitle" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/txtChooseRoleSubtitle"
            style="@style/Text.BodyXs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/chooseRoleSubtitle" />

        <!-- Customer -->
        <LinearLayout
            android:id="@+id/cardCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_role_selected"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:id="@+id/iconCustomer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_status_badge"
                android:padding="12dp"
                android:src="@drawable/icon_user"
                android:contentDescription="@string/roleCustomer"
                app:tint="@color/background_accent1" />

            <LinearLayout
                android:id="@+id/layoutCustomerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCustomerTitle"
                    style="@style/Text.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roleCustomer"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/txtCustomerDesc"
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/roleCustomerDesc"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Restaurant Manager -->
        <LinearLayout
            android:id="@+id/cardManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_role_default"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_lg">

            <ImageView
                android:id="@+id/iconManager"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_status_badge"
                android:padding="12dp"
                android:src="@drawable/icon_store"
                android:contentDescription="@string/roleManager"
                app:tint="@color/text_tertiary" />

            <LinearLayout
                android:id="@+id/layoutManagerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtManagerTitle"
                    style="@style/Text.HeadlineSm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roleManager"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/txtManagerDesc"
                    style="@style/Text.BodySm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/roleManagerDesc"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Continue -->
        <Button
            android:id="@+id/btnContinue"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/btnContinue"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>