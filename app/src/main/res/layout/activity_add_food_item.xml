<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white">

    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="28dp"
            android:paddingBottom="@dimen/space_xxl">

            <!-- Title -->

            <TextView
                android:id="@+id/txtFoodInformationTitle"
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txtAddFoodItemTitle"/>

            <TextView
                style="@style/Text.BodyXs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/txtAddFoodCaption" />

            <!-- Food Image -->

            <FrameLayout
                android:id="@+id/layoutFoodImage"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_image_upload">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFood"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded12"/>

                <TextView
                    android:id="@+id/txtAddImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textSize="32sp"/>
            </FrameLayout>

            <!-- Food Name -->

            <EditText
                android:id="@+id/etFoodName"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/hintFoodName"/>

            <!-- Category -->

            <EditText
                android:id="@+id/etCategory"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintFoodCategory"/>

            <!-- Original Price -->

            <EditText
                android:id="@+id/etOriginalPrice"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintOriginalPrice"
                android:inputType="numberDecimal"/>

            <!-- Discount Price -->

            <EditText
                android:id="@+id/etDiscountPrice"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintDiscountPrice"
                android:inputType="numberDecimal"/>

            <!-- Quantity -->

            <EditText
                android:id="@+id/etQuantity"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintFoodQuantity"
                android:inputType="number"/>

            <!-- Available Until -->

            <EditText
                android:id="@+id/etAvailableUntil"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintFoodAvailableUntil"/>

            <!-- Description -->

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_text_input"
                android:gravity="top|start"
                android:hint="@string/hintFoodDescription"
                android:inputType="textMultiLine"
                android:padding="@dimen/space_lg"/>

            <!-- Save -->

            <Button
                android:id="@+id/btnSaveFood"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btnAddFoodItem"
                app:backgroundTint="@null"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>