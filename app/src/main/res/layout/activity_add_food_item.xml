<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.HeadlineXL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txtAddFoodItemTitle" />

        <EditText
            android:id="@+id/etFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintFoodName"
            android:importantForAutofill="no"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintFoodDescription"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintFoodCategory"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etOriginalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintOriginalPrice"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etDiscountPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintDiscountPrice"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintFoodQuantity"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/etAvailableUntil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hintFoodAvailableUntil"
            android:inputType="TODO"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btnSaveFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/btnAddFoodItem" />

    </LinearLayout>

</ScrollView>