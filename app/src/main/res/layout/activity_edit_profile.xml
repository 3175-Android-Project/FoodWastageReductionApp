<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".customer.EditProfileActivity">

    <!-- Header -->
    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="28dp"
            android:paddingBottom="@dimen/space_xxl">

            <include layout="@layout/component_profile_photo" />

            <EditText
                android:id="@+id/inputFullName"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:hint="@string/hintFullName"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/etAddress"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintStreetAddressRequired"
                android:inputType="textPostalAddress|textCapWords" />

            <EditText
                android:id="@+id/etCity"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintCity"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etProvince"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintProvince"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etPostalCode"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintPostalCode"
                android:inputType="textCapCharacters"
                android:maxLength="7" />

            <EditText
                android:id="@+id/etPhone"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintPhone"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnChangePassword"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/btnChangePassword" />

            <Button
                android:id="@+id/btnSaveChanges"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btnSaveChanges"
                app:backgroundTint="@null" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
