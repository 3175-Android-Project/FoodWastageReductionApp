<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.ResetLinkSentActivity">

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="120dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon circle -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_status_badge">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/icon_mail_check"
                android:contentDescription="@string/resetCodeSentTitle"
                app:tint="@color/background_accent1" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtResetLinkSentTitle"
            style="@style/Text.HeadlineMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/resetCodeSentTitle"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/txtResetLinkSentMessage"
            style="@style/Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            tools:text="If an account exists for&#10;aaa@gmail.com,&#10;you'll receive a link to reset your password shortly." />

        <Button
            android:id="@+id/btnBackToLogin"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="56dp"
            android:text="@string/btnBackToLogin"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnResendLink"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/bg_role_default"
            android:fontFamily="@font/pretendard_semibold"
            android:text="@string/btnResendCode"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_sm"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>