<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    tools:context=".MainActivity">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_status_badge"
        android:padding="16dp"
        android:src="@drawable/icon_leaf"
        app:tint="@color/background_accent1"
        app:layout_constraintBottom_toTopOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_xl" />
    <!-- App Name -->
    <TextView
        android:id="@+id/txtTitle"
        style="@style/Text.HeadlineXL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Good Food&#10;Less Waste"
        app:layout_constraintBottom_toTopOf="@id/txtDescription"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_md" />

    <!-- Description -->
    <TextView
        android:id="@+id/txtDescription"
        style="@style/Text.BodySm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Delicious food at a lower price&#10;—for a greener tomorrow."
        app:layout_constraintBottom_toTopOf="@id/btnLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="300dp" />

    <!-- Login -->

    <Button
        android:id="@+id/btnLogin"
        style="@style/Button.Primary"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"

        android:text="Log in"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btnCreateAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_sm" />

    <!-- Create Account -->
    <Button
        android:id="@+id/btnCreateAccount"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_card"
        android:text="Create account"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body_sm"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="@dimen/space_md" />

</androidx.constraintlayout.widget.ConstraintLayout>