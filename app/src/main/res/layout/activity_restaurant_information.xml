<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.RestaurantInformationActivity">

    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="28dp"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:id="@+id/txtRestaurantInformationTitle"
                style="@style/Text.HeadlineSm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restaurantInformationTitle" />

            <TextView
                android:id="@+id/txtRestaurantInformationDesc"
                style="@style/Text.BodyXs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/restaurantInformationDesc" />

            <FrameLayout
                android:id="@+id/layoutRestaurantImage"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_image_upload">

                <ImageView
                    android:id="@+id/imgRestaurant"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/restaurantInformationTitle" />

                <TextView
                    android:id="@+id/txtAddImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp" />

            </FrameLayout>

            <EditText
                android:id="@+id/editRestaurantName"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/hintRestaurantName"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/editRestaurantCity"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintCity"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/editRestaurantProvince"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintProvince"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/editRestaurantPostalCode"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintPostalCode"
                android:inputType="textCapCharacters" />

            <EditText
                android:id="@+id/editRestaurantPhone"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintPhoneNumber"
                android:inputType="phone" />

            <EditText
                android:id="@+id/editCuisineType"
                style="@style/Input.Default"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hintCuisineType"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/editRestaurantDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_text_input"
                android:fontFamily="@font/pretendard_regular"
                android:gravity="top|start"
                android:hint="@string/hintRestaurantDescription"
                android:inputType="textMultiLine"
                android:padding="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_body_sm" />

            <Button
                android:id="@+id/btnGoToDashboard"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/btnGoToDashboard"
                app:backgroundTint="@null" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>