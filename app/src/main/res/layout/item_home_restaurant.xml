<?xml version="1.0" encoding="utf-8"?>
<!-- One "Nearby" restaurant card on the Home screen (same look as the old fixed cards) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Default"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgRestaurant"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@color/background_secondary"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/txtRestaurantName"
        style="@style/Text.HeadlineSm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Awesome sushi" />

    <TextView
        android:id="@+id/txtRestaurantAddress"
        style="@style/Text.BodySm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Vancouver, BC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/background_accent1"
            android:textSize="@dimen/text_body_md"
            tools:text="$8.50" />

        <TextView
            android:id="@+id/txtItemsLeft"
            style="@style/Text.BodySm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="5 left" />

    </LinearLayout>

</LinearLayout>