<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".manager.ManagerDashboardActivity">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.BodySm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_semibold"
                    android:text="@string/titleManagerDashboard"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/icon_bell"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/txtProfile" />

            </LinearLayout>

            <!-- Restaurant Name -->
            <TextView
                android:id="@+id/txtRestaurantName"
                style="@style/Text.HeadlineXL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sampleRestaurantSushi1" />

            <!-- Order Status Summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <!-- Pending -->
                <LinearLayout
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtPendingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="5"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp" />

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/statusPending" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- Accepted -->
                <LinearLayout
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtAcceptedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="8"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp" />

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/statusAccepted" />

                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <!-- Ready -->
                <LinearLayout
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtReadyCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="12"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp" />

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/statusReady" />

                </LinearLayout>

            </LinearLayout>

            <!-- Manage Food Items -->
            <LinearLayout
                android:id="@+id/cardManageItems"
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_status_badge"
                    android:padding="11dp"
                    android:src="@drawable/icon_food"
                    app:tint="@color/background_accent1"
                    android:contentDescription="@string/actionManageFoodItems" />

                <TextView
                    style="@style/Text.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/actionManageFoodItems" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_right"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/actionManageFoodItems" />

            </LinearLayout>

            <!-- Active Orders -->
            <LinearLayout
                android:id="@+id/cardActiveOrders"
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_status_badge"
                    android:padding="11dp"
                    android:src="@drawable/icon_receipt"
                    app:tint="@color/background_accent1"
                    android:contentDescription="@string/actionViewActiveOrders" />

                <TextView
                    style="@style/Text.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/actionViewActiveOrders" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_right"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/actionViewActiveOrders" />

            </LinearLayout>

            <!-- Order History -->
            <LinearLayout
                android:id="@+id/cardOrderHistory"
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_status_badge"
                    android:padding="11dp"
                    android:src="@drawable/icon_history"
                    app:tint="@color/background_accent1"
                    android:contentDescription="@string/txtOrderHistoryTitle" />

                <TextView
                    style="@style/Text.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/txtOrderHistoryTitle" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_right"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/txtOrderHistoryTitle" />

            </LinearLayout>

            <!-- Restaurant Profile -->
            <LinearLayout
                android:id="@+id/cardRestaurantProfile"
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_status_badge"
                    android:padding="11dp"
                    android:src="@drawable/icon_user"
                    app:tint="@color/background_accent1"
                    android:contentDescription="@string/actionRestaurantProfile" />

                <TextView
                    style="@style/Text.HeadlineSm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/actionRestaurantProfile" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_right"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/actionRestaurantProfile" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Shimmer Skeleton Loading State -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerViewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shimmer_duration="1000">

        <include layout="@layout/layout_skeleton_manager_home" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <View
        android:id="@+id/navDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/background_secondary"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Manager Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_white"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_manager_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
