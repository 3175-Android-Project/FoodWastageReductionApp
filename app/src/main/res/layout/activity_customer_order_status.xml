<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".customer.CustomerOrderStatusActivity">

    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxl">

            <!-- Status icon (colours are set in code) -->
            <ImageView
                android:id="@+id/imgStatusIcon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_status_badge"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/icon_package"
                app:tint="@color/background_accent1" />

            <TextView
                android:id="@+id/txtStatusTitle"
                style="@style/Text.HeadlineLg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                tools:text="Waiting for the restaurant" />

            <TextView
                android:id="@+id/txtStatusDesc"
                style="@style/Text.BodySm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                tools:text="We’ll update you when the restaurant responds." />

            <!-- Steps: Pending, Accepted, Preparing, Ready (filled in code) -->
            <LinearLayout
                android:id="@+id/llSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="horizontal" />

            <!-- Order summary -->
            <LinearLayout
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtOrderNumber"
                        style="@style/Text.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Order #1022" />

                    <TextView
                        android:id="@+id/txtOrderStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:textSize="@dimen/text_body_xs"
                        tools:text="Pending" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtPickupAddress"
                    style="@style/Text.BodyXs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    tools:text="Pickup · 123 Food St, Vancouver" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@color/background_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.HeadlineSm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lblTotal" />

                    <TextView
                        android:id="@+id/txtTotal"
                        style="@style/Text.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="$8.00" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pickup information: method + time (same cards as Order Detail) -->
            <LinearLayout
                android:id="@+id/llPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lblMethod"
                        android:textColor="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/txtMethod"
                        style="@style/Text.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        tools:text="Pickup" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.BodySm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lblTime"
                        android:textColor="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/txtPickupTime"
                        style="@style/Text.HeadlineSm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        tools:text="6:00 PM" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cancel (only while Pending) -->
            <Button
                android:id="@+id/btnCancelOrder"
                style="@style/Button.Warning"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/btnCancelOrder"
                app:backgroundTint="@null" />

            <TextView
                android:id="@+id/txtCancelNote"
                style="@style/Text.BodyXs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/msgCancelNotAllowed"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
