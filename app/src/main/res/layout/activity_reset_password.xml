<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.ResetPasswordActivity">

    <!-- Header -->
    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtResetPasswordTitle"
            style="@style/Text.HeadlineMd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/resetPasswordTitle" />

        <TextView
            android:id="@+id/txtResetPasswordDesc"
            style="@style/Text.BodySm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/resetPasswordDesc"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/editNewPassword"
            style="@style/Input.Default"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:hint="@string/hintNewPassword"
            android:inputType="textPassword" android:saveEnabled="false" />

        <EditText
            android:id="@+id/editConfirmNewPassword"
            style="@style/Input.Default"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/hintConfirmNewPassword"
            android:inputType="textPassword" android:saveEnabled="false" />

        <Button
            android:id="@+id/btnResetPassword"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/btnResetPassword"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
