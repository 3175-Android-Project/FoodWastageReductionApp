<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".auth.SignUpActivity">

    <!-- Header -->
    <include
        android:id="@+id/header"
        layout="@layout/component_header"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Content -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/Text.HeadlineSm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/titleCreateAccount" />

        <EditText
            android:id="@+id/editEmail"
            style="@style/Input.Default"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:hint="@string/hintEmail"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress" />

        <EditText
            android:id="@+id/editPassword"
            style="@style/Input.Default"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/hintPassword"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <EditText
            android:id="@+id/editConfirmPassword"
            style="@style/Input.Default"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/hintConfirmPassword"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/btnContinue"
            app:backgroundTint="@null" />

        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.BodyXs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txtAlreadyHaveAccount"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtLogin"
                style="@style/Text.BodyXs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/actionLogin"
                android:textColor="@color/background_accent1" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
